# ============================================
# Queen Style - Production Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# ============================================
# Database Configuration
# ============================================

# Option 1: Use Neon (or other external database)
# Copy your DATABASE_URL from Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# Option 2: Use local PostgreSQL (only if using docker-compose.prod.yml)
# POSTGRES_USER=queenstyle
# POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
# POSTGRES_DB=queen_style
# POSTGRES_PORT=5432

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ============================================
# Session Configuration
# ============================================
# Generate a strong secret: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# ============================================
# Frontend Configuration
# ============================================
# Your domain name (for CORS and redirects)
FRONTEND_URL=https://yourdomain.com
# Or for HTTP: http://yourdomain.com

# Frontend API URL (used by Next.js)
# For Docker internal network, use: http://backend:3000
# For browser access, use your domain: https://yourdomain.com/api
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ============================================
# Nginx Configuration
# ============================================
HTTP_PORT=80
HTTPS_PORT=443

# ============================================
# Optional: SSL Certificate Paths
# ============================================
# If using Let's Encrypt or custom certificates
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

